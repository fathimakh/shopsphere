{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "ShopSphere REST API - Node.js, Express 5 and MongoDB backend with JWT auth, RBAC and RapidMiner-powered recommendations",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed": "node scripts/seed.js",
    "snapshot:products": "node scripts/buildProductSnapshot.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:api": "newman run postman/ShopSphere.postman_collection.json -e postman/local.postman_environment.json"
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "jwt",
    "rbac",
    "ecommerce",
    "rapidminer",
    "recommendations"
  ],
  "author": "Fathima K H",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "nodemonConfig": {
    "watch": [
      "index.js",
      "config",
      "controllers",
      "middleware",
      "models",
      "routes",
      "services",
      "utils",
      "validators"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
