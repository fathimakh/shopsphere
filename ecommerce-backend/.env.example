# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=5050
# Local Docker MongoDB (docker run -d --name m5-mongo -p 27035:27017 mongo:7) or a MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27035/shopsphere
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5175,http://localhost:4173
# Requests per 15 minutes per IP on /api/auth
AUTH_RATE_LIMIT_MAX=100
# Accounts created by `npm run seed`
SEED_ADMIN_EMAIL=admin@shopsphere.dev
SEED_ADMIN_PASSWORD=Admin@123

# RapidMiner AI Hub / Server (optional - live scoring is used only when the URL is set)
RAPIDMINER_SCORING_URL=
RAPIDMINER_AUTH_TOKEN=
RAPIDMINER_USERNAME=
RAPIDMINER_PASSWORD=
RAPIDMINER_TIMEOUT_MS=4000
# How long the built-in collaborative-filtering model is cached (seconds)
RECO_CACHE_TTL_SECONDS=300
